      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst now = DateTime.now().setZone('Asia/Jakarta');\n\nconst postsToSend = [];\n\nfor (const item of items) {\n  const row = item.json;\n\n  const dateStr = row['Scheduled Date'];\n  const timeStr = row['Scheduled Time'];\n\n  if (row.Status === 'Pending' && dateStr && timeStr) {\n\n    const scheduledTime = DateTime.fromFormat(\n      `${dateStr} ${timeStr}`,\n      'dd/MM/yyyy H:mm:ss',\n      { zone: 'Asia/Jakarta' }\n    );\n\n    // sementara belum cek waktu\n    postsToSend.push(item);\n  }\n}\n\nreturn postsToSend;"
      },
